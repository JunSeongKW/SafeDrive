+    def canonical_future_position_embeddings(
+        self,
+        canonical_future_token_ids: torch.Tensor,
+        *,
+        time_offset: int,
+        dtype: torch.dtype,
+        device: torch.device,
+    ) -> torch.Tensor:
+        """Preserve the original camera/time/spatial positions after sparse packing.
+
+        Canonical IDs flatten camera -> future tubelet -> row/column. They are
+        not object identities. No new parameters or checkpoint keys are added.
+        """
+        future_steps = self.max_time_steps - int(time_offset)
+        future_tokens_per_camera = future_steps * self.tokens_per_step
+        camera_ids = torch.div(canonical_future_token_ids, future_tokens_per_camera, rounding_mode="floor")
+        local_future_ids = canonical_future_token_ids % future_tokens_per_camera
+        time_ids, spatial_ids = self._position_from_token_indices(local_future_ids, time_offset=time_offset)
+        if int(camera_ids.min().item()) < 0 or int(camera_ids.max().item()) >= self.num_cameras:
+            raise ValueError("Canonical future ID outside camera/time/spatial range")
+        batch_size, num_selected_tokens = canonical_future_token_ids.shape
+        camera_position = self.camera_embed.to(dtype=dtype, device=device).index_select(0, camera_ids.flatten()).reshape(batch_size, num_selected_tokens, self.scene_dim)
+        time_position = self.time_embed.to(dtype=dtype, device=device)[0].index_select(0, time_ids.flatten()).reshape(batch_size, num_selected_tokens, self.scene_dim)
+        spatial_position = self.spatial_embed.to(dtype=dtype, device=device).reshape(self.tokens_per_step, self.scene_dim).index_select(0, spatial_ids.flatten()).reshape(batch_size, num_selected_tokens, self.scene_dim)
+        return camera_position + time_position + spatial_position
